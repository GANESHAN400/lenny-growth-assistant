# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend directory and populate secret values.
# NEVER commit real credentials, tokens, or API keys to version control.

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Connection string for relational database (PostgreSQL / SQLite)
DATABASE_URL=

# ------------------------------------------------------------------------------
# Supabase Integration
# ------------------------------------------------------------------------------
# Supabase Project URL and API Key for hosted database / auth / storage
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------------------------------------------
# AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Default active LLM provider (e.g., ollama, anthropic)
DEFAULT_PROVIDER=ollama

# Ollama Local LLM Provider Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic API Credentials
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Application & Logging Configuration
# ------------------------------------------------------------------------------
# Logging verbosity level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

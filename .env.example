# ─────────────────────────────────────────────────────────────────
# Lenny Growth Assistant — Environment Configuration Template
#
# Copy this file to backend/.env for local development.
# NEVER commit actual secrets to version control.
# ─────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────

# SQLite (default, no setup required for local development):
DATABASE_URL=sqlite+pysqlite:///./lenny.db

# PostgreSQL (production / Supabase):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/lenny_db

# Supabase (if using Supabase as PostgreSQL host):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────────
# Supabase Integration (optional)
# ─────────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=

# Your Supabase anon/public key
SUPABASE_KEY=

# ─────────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ─────────────────────────────────────────────────────────────────

# Default LLM provider: "ollama" (local) or "anthropic" (cloud)
DEFAULT_PROVIDER=ollama

# ─── Ollama (local, free) ──────────────────────────────────────
# URL to your running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model. Run `ollama pull <model>` to download.
# Options: qwen2.5:7b, llama3.1:8b, mistral:7b, phi3:mini, gemma2:9b
OLLAMA_MODEL=qwen2.5:7b

# ─── Anthropic Claude (cloud) ─────────────────────────────────
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated). Set to * for development.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
